PORT=8001
MONGO_URI=mongodb://127.0.0.1:27017/url_shortener
JWT_SECRET=change-me-to-a-long-random-string
BASE_URL=http://localhost:8001
CLIENT_URL=http://localhost:5173
# Optional: enables Redis caching (falls back to in-memory cache if empty)
REDIS_URL=
# Optional: the user who signs up with this email becomes ADMIN
ADMIN_EMAIL=admin@example.com

# --- ML malicious-URL detection (on by default) ---
# THREAT_DETECTION=off          # switch the model off completely
THREAT_FLAG_THRESHOLD=0.5       # score >= this: link is created but visitors see a warning first
THREAT_BLOCK_THRESHOLD=0.9      # score >= this: link is refused
TRUSTED_DOMAINS=csvtu.ac.in     # comma separated hosts (and sub-domains) that skip the model

# --- LLM features (optional; the app works without them) ---
# Enables AI alias suggestions, AI categorisation and "Ask AI about this link".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
